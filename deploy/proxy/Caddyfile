# TailTicket — unico punto d'ingresso.
#   /classic/…  → pannello classico osTicket (PHP): scp/, api/ (REST e pipe email), asset
#   tutto il resto → TailTicket (portale clienti, /agent, /admin)
# Variabili (da deploy/.env): TAILTICKET_SITE (indirizzo del sito Caddy), TAILTICKET_HTTPS (auto|off|internal),
# TAILTICKET_CLASSIC_PORTAL (redirect|keep), TAILTICKET_TRUSTED_PROXIES, TAILTICKET_MAX_BODY.
#
# IP del client: Caddy è l'ingresso pubblico e NON si fida degli X-Forwarded-For ricevuti, salvo dai proxy
# elencati in TAILTICKET_TRUSTED_PROXIES (CIDR di un CDN o bilanciatore davanti a Caddy; il default
# 127.0.0.1/32 equivale a nessuno). {client_ip} è quindi l'indirizzo reale e arriva alle app in X-Real-IP,
# che sovrascrive qualsiasi valore mandato dal client (vedi SECURITY.md, "Reverse proxy e IP del client").
{
	servers {
		trusted_proxies static {$TAILTICKET_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

(tls_auto) {
}
(tls_off) {
}
(tls_internal) {
	tls internal
}

# Link del vecchio portale clienti (email, segnalibri) e link con token delle email agli agenti verso le
# pagine di TailTicket
(portal_redirect) {
	@classicHome path /classic/ /classic/index.php
	redir @classicHome / 302
	redir /classic/view.php /view?{query} 302
	@ticketById {
		path /classic/tickets.php
		query id=*
	}
	redir @ticketById /tickets/{query.id} 302
	redir /classic/tickets.php /tickets 302
	redir /classic/login.php /login?{query} 302
	redir /classic/pwreset.php /pwreset?{query} 302
	redir /classic/account.php /account?{query} 302
	redir /classic/open.php /open 302
	redir /classic/profile.php /profile 302
	@faqById {
		path /classic/kb/faq.php
		query id=*
	}
	redir @faqById /kb/faq/{query.id} 302
	redir /classic/kb/* /kb 302
	# link con token delle email agli agenti (benvenuto, reset password): solo GET con token, così il
	# modulo "password dimenticata" del pannello classico (GET senza token, POST) resta del PHP
	@staffResetLink {
		path /classic/scp/pwreset.php
		method GET
		query token=*
	}
	redir @staffResetLink /agent/login/reset?{query} 302
}
(portal_keep) {
}

{$TAILTICKET_SITE::80} {
	import tls_{$TAILTICKET_HTTPS:off}
	encode zstd gzip
	header -Server
	# corpo delle richieste limitato (allegati: max_file_size di osTicket, upload_max_filesize di PHP 32M)
	request_body {
		max_size {$TAILTICKET_MAX_BODY:40MB}
	}

	# senza slash finale Apache risponderebbe con un redirect assoluto in http://
	redir /classic /classic/ 308
	redir /classic/scp /classic/scp/ 308

	# redir viene valutata prima di handle (ordine predefinito delle direttive di Caddy)
	import portal_{$TAILTICKET_CLASSIC_PORTAL:redirect}

	# diagnostica (/api/doctor): solo dall'interno del container con ./tailticket doctor, mai da fuori
	# (handle e non respond: handle viene valutata prima di respond e il blocco finale prenderebbe tutto)
	handle /api/doctor* {
		respond 404
	}

	handle /classic/* {
		reverse_proxy osticket:80 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		reverse_proxy tailticket:3000 {
			header_up X-Real-IP {client_ip}
		}
	}
}
