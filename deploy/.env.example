# TailTicket — configurazione dello stack (copiare in .env oppure usare ./tailticket init, che genera i segreti).
# Le righe "CHANGE_ME" vanno sostituite: ./tailticket up si rifiuta di partire se ne restano.

# --- File compose da usare -------------------------------------------------------------------------
# build locale dal repository (default) · solo immagini GHCR: compose.yaml · osTicket esistente: compose.attach.yaml
COMPOSE_FILE=compose.yaml:compose.build.yaml
# profilo "mail" = Mailpit per le prove in locale: cattura tutte le email (reset password, codici 2FA)
# e la sua interfaccia non ha password. ./tailticket init lo attiva solo con localhost; in produzione vuoto
COMPOSE_PROFILES=mail

# --- Indirizzo pubblico ---------------------------------------------------------------------------
# dominio (o IP) con cui si raggiunge l'helpdesk; localhost per le prove
TAILTICKET_DOMAIN=localhost
# URL pubblico completo (link nelle email): https://helpdesk.example.com
TAILTICKET_URL=http://localhost
# HTTPS: auto = certificato Let's Encrypt (dominio pubblico, porte 80/443 raggiungibili da internet)
#        internal = certificato della CA interna di Caddy (rete aziendale, accesso via IP) · off = solo HTTP (localhost)
TAILTICKET_HTTPS=off
# indirizzo del sito per Caddy: ":80" con HTTPS off, altrimenti il dominio
TAILTICKET_SITE=:80
TAILTICKET_HTTP_PORT=80
TAILTICKET_HTTPS_PORT=443
# link del vecchio portale clienti (/classic/view.php, tickets.php…) e link con token agli agenti reindirizzati a TailTicket: redirect | keep
TAILTICKET_CLASSIC_PORTAL=redirect

# --- Segreti (generati da ./tailticket init) --------------------------------------------------------
# SECRET_SALT di osTicket: firma i Message-ID e cifra le password degli account email. NON cambiarlo dopo l'installazione.
TAILTICKET_SECRET_SALT=CHANGE_ME
# firma dei cookie di sessione di TailTicket (>= 32 caratteri casuali: openssl rand -base64 48);
# TailTicket non parte con un valore di esempio
TAILTICKET_SESSION_SECRET=CHANGE_ME
TAILTICKET_DB_PASSWORD=CHANGE_ME
TAILTICKET_DB_ROOT_PASSWORD=CHANGE_ME
# token dell'header X-Doctor-Token di /api/doctor (./tailticket doctor; almeno 32 caratteri casuali)
TAILTICKET_DOCTOR_TOKEN=CHANGE_ME

# --- Modalità di scrittura ------------------------------------------------------------------------
# readonly = nessuna scrittura · operational = ticket, task, utenti e portale (area admin in sola lettura)
# · full = tutto. Vuota = full nello stack integrato; in modalità attach il default è readonly.
# Si cambia con ./tailticket mode (in attach verifica prima doctor e backup); ./tailticket readonly = emergenza
# TAILTICKET_MODE=
# età massima in ore dell'ultimo ./tailticket backup per passare a operational o full in attach
# TAILTICKET_BACKUP_MAX_AGE_HOURS=24

# --- Database ------------------------------------------------------------------------------------
TAILTICKET_DB_NAME=osticket
TAILTICKET_DB_USER=osticket
TAILTICKET_TABLE_PREFIX=ost_

# --- Prima installazione (solo con database vuoto) --------------------------------------------------
TAILTICKET_INSTALL=auto
TAILTICKET_HELPDESK_NAME=TailTicket
TAILTICKET_SYSTEM_EMAIL=support@example.com
# username: non sono ammessi admin, admins, username, osticket
TAILTICKET_ADMIN_USER=ttadmin
TAILTICKET_ADMIN_PASSWORD=CHANGE_ME
# deve essere diversa da TAILTICKET_SYSTEM_EMAIL
TAILTICKET_ADMIN_EMAIL=admin@example.com
TAILTICKET_TIMEZONE=Europe/Rome

# --- Email in uscita ------------------------------------------------------------------------------
# relay SMTP per osTicket (mail()) e per TailTicket: smtp://utente:password@host:587 (STARTTLS) o smtps://…:465
# con il profilo "mail": smtp://mailpit:1025 (interfaccia su http://127.0.0.1:8025)
TAILTICKET_SMTP_URL=smtp://mailpit:1025
TAILTICKET_MAILPIT_PORT=8025

# --- Reverse proxy e IP del client (SECURITY.md) ------------------------------------------------------
# CIDR dei proxy/CDN davanti a Caddy di cui fidarsi per X-Forwarded-For (default: nessuno). Mai
# "private_ranges" se Caddy riceve traffico da reti non fidate: chiunque potrebbe scegliersi l'IP.
# TAILTICKET_TRUSTED_PROXIES=203.0.113.0/24
# proxy fidati davanti a TailTicket (Caddy = 1): l'IP del client arriva in X-Real-IP
# TAILTICKET_TRUSTED_PROXY_HOPS=1
# dimensione massima di una richiesta (allegati)
# TAILTICKET_MAX_BODY=40MB

# --- Modalità attach: osTicket già in produzione (compose.attach.yaml, ./tailticket init --attach) -----
# init --attach scrive un .env proprio con solo queste chiavi; qui sono elencate per riferimento.
# Fonte unica consigliata: l'ost-config.php dell'osTicket, montato in sola lettura (DB, prefisso, SECRET_SALT)
# OST_CONFIG_FILE=/var/www/osticket/include/ost-config.php
# OST_CONFIG_PATH_IN_CONTAINER=/etc/osticket/ost-config.php
# Con ost-config.php montato nessuna OST_DB_* va impostata: una variabile con un valore diverso dal file
# blocca l'avvio. Senza file, o in modalità "copia" (il container raggiunge il DB con un altro indirizzo,
# es. DBHOST=localhost → host.docker.internal, o con un utente dedicato), sono la configurazione del DB:
# passate al container solo se presenti, e ./tailticket le riconfronta a ogni avvio con il file d'origine.
# OST_CONFIG_COPIED_FROM=/var/www/osticket/include/ost-config.php
# OST_DB_HOST=host.docker.internal
# OST_DB_PORT=3306
# OST_DB_NAME=
# OST_DB_USER=
# OST_DB_PASS=
# OST_TABLE_PREFIX=
# OST_SECRET_SALT=
# fuso orario del server MySQL; vuoto = ricavato dall'offset del DB
# OST_DB_TIMEZONE=Europe/Rome
# allegati su disco del plugin storage-fs: cartella del server (montata in sola lettura) e percorso nel container
# OST_ATTACHMENTS_HOST_DIR=/var/www/osticket-files
# OST_ATTACHMENTS_DIR=/var/lib/osticket-attachments
# gruppo (gid) con cui il container legge ost-config.php e gli allegati se non sono leggibili da tutti
# TAILTICKET_FILES_GID=33
# URL del pannello osTicket esistente (pulsante "Apri nel pannello classico")
# TAILTICKET_CLASSIC_URL=https://helpdesk.example.com

# --- Aggiornamenti ----------------------------------------------------------------------------------
# applica le patch di schema di osTicket all'avvio (php manage.php upgrade)
TAILTICKET_AUTO_UPGRADE=true
# allinea helpdesk_url di osTicket a TAILTICKET_URL/classic/
TAILTICKET_SYNC_URL=true
TAILTICKET_CRON_INTERVAL=300

# --- Immagini (vuote = build locale) ----------------------------------------------------------------
# TAILTICKET_IMAGE=ghcr.io/paolo-trivi/tailticket:1.0.0
# TAILTICKET_LEGACY_IMAGE=ghcr.io/paolo-trivi/tailticket-legacy:1.0.0
# CA aggiuntiva per build dietro proxy TLS aziendale
# TAILTICKET_BUILD_CA=/etc/ssl/certs/corporate-ca.crt
