# Percorso di include/ost-config.php dell'installazione osTicket (sola lettura):
# fornisce DB, TABLE_PREFIX e SECRET_SALT condivisi con il PHP.
OST_CONFIG_PATH=/home/user/ost-dev/www/include/ost-config.php

# In alternativa (o per sovrascrivere) i singoli valori:
# OST_DB_HOST=127.0.0.1
# OST_DB_PORT=3306
# OST_DB_NAME=osticket
# OST_DB_USER=osticket
# OST_DB_PASS=osticket
# OST_TABLE_PREFIX=ost_
# OST_SECRET_SALT=...

# Fuso orario del server MySQL (consigliato in produzione, es. Europe/Rome)
# OST_DB_TIMEZONE=Europe/Rome

# URL pubblico dell'osTicket PHP (link nelle email, rimandi tra le due interfacce)
OST_PHP_URL=http://127.0.0.1:8080

# Segreto (>= 32 caratteri) per firmare i cookie di sessione della app Next
APP_SESSION_SECRET=cambiami-cambiami-cambiami-cambiami-0000
